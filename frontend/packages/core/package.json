{
  "name": "@namorix/core",
  "version": "0.66.0",
  "license": "AGPL-3.0-only",
  "author": "IzeroCs",
  "keywords": [
    "namorix",
    "desktop",
    "shell",
    "types",
    "auth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Namorix/namorix.git"
  },
  "bugs": {
    "url": "https://github.com/Namorix/namorix/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "",
    "build": "tsup",
    "build:dts": "tsup --dts",
    "lint": "eslint ."
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./env": {
      "types": "./src/env/development.ts",
      "development": "./src/env/development.ts",
      "default": "./src/env/production.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "import": "./src/auth/index.ts"
    },
    "./addon": {
      "types": "./src/addon/index.ts",
      "import": "./src/addon/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts"
    },
    "./router": {
      "types": "./src/router/index.ts",
      "import": "./src/router/index.ts"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "import": "./src/http/index.ts"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "import": "./src/i18n/index.ts"
    }
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.0",
    "i18next": "26.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "17.0.8",
    "react-router-dom": "7.15.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "tsup": "^8.5.1",
    "@reduxjs/toolkit": "2.12.0"
  }
}
